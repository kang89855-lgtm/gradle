# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (dev / staging / prod each get their own file:
# .env.development / .env.staging / .env.production — never commit real values)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/affiliate_platform?schema=public"

# ── App ───────────────────────────────────────────────────────────────────────
# Absolute origin used for canonical URLs, hreflang and sitemaps
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# One of: development | staging | production
APP_ENV="development"

# ── Affiliate credentials (never hardcode these in source) ────────────────────
# Booking.com Affiliate Partner ID
AFFILIATE_BOOKING_AID=""
# Agoda Affiliate cid
AFFILIATE_AGODA_CID=""
# Klook affiliate id
AFFILIATE_KLOOK_AID=""
# GetYourGuide partner id
AFFILIATE_GYG_PARTNER_ID=""

# ── Analytics ─────────────────────────────────────────────────────────────────
# Salt for hashing visitor identifiers in ClickEvent (privacy: no raw IPs stored)
CLICK_HASH_SALT="change-me"
